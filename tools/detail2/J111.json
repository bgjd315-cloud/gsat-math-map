    "tex": "\\sin\\alpha=\\dfrac{\\text{對邊}}{\\text{斜邊}},\\ \\tan\\alpha=\\dfrac{\\text{對邊}}{\\text{鄰邊}}",
    "vars": [],
    "cond": ""
   }
  ],
  "steps": [
   {
    "q": "$\\overline{A'F'}$ 和 $\\overline{A'A}$ 各代表什麼？",
    "calc": [
